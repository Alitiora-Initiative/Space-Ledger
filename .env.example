# Keep the RPC endpoint on Solana Devnet. This is read by the server only.
# Prefer a dedicated provider (Helius / QuickNode) for hackathon reliability.
# Do NOT put API keys in public client code or commit .env.
#
# Helius Devnet example:
# SOLANA_RPC_DEVNET=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
#
# WARNING: https://beta.helius-rpc.com and mainnet.helius-rpc.com are MAINNET.
# Using mainnet with this app will break quotes and purchases.
SOLANA_RPC_DEVNET=https://api.devnet.solana.com

# Public Devnet program ID.
SOLANA_PROGRAM_ID=EbP7vsnMXPonTfriPUFynco69d69JiXpWbKnwVmz8sgG

PORT=3000
NODE_ENV=development
