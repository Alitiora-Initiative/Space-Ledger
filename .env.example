# ============================================================
# Space Ledger — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.
#
# ⚠️  SUPABASE KEY GUIDE:
#   SUPABASE_ANON_KEY    = "anon / public" key from Project Settings → API
#                          Safe for read-only browser calls.
#   SUPABASE_SERVICE_KEY = "service_role" secret key (the second one)
#                          Server-only. Bypasses RLS. NEVER expose to the browser.
# ============================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_KEY=eyJhbGci...YOUR_SERVICE_ROLE_KEY_HERE

# ── Platform wallet (server-only — never sent to the browser) ─────────────────
FEE_WALLET_ADDRESS=YOUR_SOLANA_BASE58_WALLET_ADDRESS

# ── Solana network ────────────────────────────────────────────────────────────
# 'devnet' for testing, 'mainnet-beta' for production
SOLANA_NETWORK=devnet
SOLANA_RPC_DEVNET=https://api.devnet.solana.com
SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
